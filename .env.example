# Copy this file to `.env` and fill in your own key from https://tokenmix.ai/dashboard/keys
EXPO_PUBLIC_TOKENMIX_API_KEY=sk-tm-xxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_TOKENMIX_BASE_URL=https://api.tokenmix.ai/v1
EXPO_PUBLIC_LLM_MODEL=gemini-3.1-flash-lite-preview
EXPO_PUBLIC_TRANSCRIBE_MODEL=whisper-1

# Groq fallback (used automatically if TokenMix fails / daily limit exceeded).
# Get a free key at https://console.groq.com/keys
EXPO_PUBLIC_GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_GROQ_BASE_URL=https://api.groq.com/openai/v1
EXPO_PUBLIC_GROQ_MODEL=llama-3.3-70b-versatile
EXPO_PUBLIC_GROQ_TRANSCRIBE_MODEL=whisper-large-v3
